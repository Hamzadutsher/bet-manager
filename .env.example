# Copiez ce fichier en « .env » puis renseignez votre URL de base de données PostgreSQL.
# Exemples :
#   Prisma Postgres : postgres://...  (fourni par l'intégration Vercel/Prisma)
#   Neon            : postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
